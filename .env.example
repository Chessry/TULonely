# TUlonely Frontend Environment Variables

# VITE_API_URL: Base URL for TUlonely Backend API
# Example for local development: http://localhost:5000/api
# When not set, defaults to http://localhost:5000/api (with automatic fallback to localStorage if unreachable)
VITE_API_URL="http://localhost:5000/api"

# VITE_USE_MOCK: Set to "true" to force mock data/localStorage mode without attempting backend requests
VITE_USE_MOCK="false"
